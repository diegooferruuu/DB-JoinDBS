# ============================================================================
# Configuración de Variables de Entorno para Migración ETL
# ============================================================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo a .env:
#    cp .env.example .env
#
# 2. Editar el archivo .env con tus credenciales reales
#
# 3. IMPORTANTE: El archivo .env contiene credenciales sensibles
#    ⚠️ NUNCA comitear .env en git (debe estar en .gitignore)
#    ✓ Comitear .env.example como plantilla
#
# ============================================================================

# Base de Datos ORIGEN (PostgreSQL 9)
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
SOURCE_DB_URL=postgresql://postgres:password@localhost:5432/datax_db

# Base de Datos DESTINO (PostgreSQL 18)
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
DESTINATION_DB_URL=postgresql://postgres:password@localhost:5433/datax_db

# ============================================================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================================================

# Ejemplo 1: Conexiones Locales
# SOURCE_DB_URL=postgresql://postgres:pass123@localhost:5432/datax_old
# DESTINATION_DB_URL=postgresql://postgres:pass123@localhost:5433/datax_new

# Ejemplo 2: Conexiones Remotas
# SOURCE_DB_URL=postgresql://dbuser:secure_pwd@192.168.1.100:5432/production_db
# DESTINATION_DB_URL=postgresql://dbuser:secure_pwd@migration.example.com:5432/staging_db

# Ejemplo 3: Con caracteres especiales en contraseña (URL-encoded)
# @ en contraseña → %40
# : en contraseña → %3A
# # en contraseña → %23
# SOURCE_DB_URL=postgresql://user:pass%40word@localhost:5432/db

# ============================================================================
